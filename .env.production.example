# Production environment for SYCUMAIN V3 (docker-compose.prod.yml).
#
# Copy to `.env.production` — which is git-ignored and must never be committed —
# and replace every REPLACE_ME value. Generate secrets with:
#
#   openssl rand -hex 32
#
# The API validates this file at startup and refuses to run in production with
# a weak secret, the documented portal:portal database credentials, demo
# seeding, the `dev` password-reset channel or a permissive malware scanner.

# --- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=sycumain-v3-prod

# --- Public origin ---------------------------------------------------------
# The single origin users visit. Must be https:// — the API requires an https
# origin in production, and the session cookie is marked Secure.
APP_ORIGIN=https://portal.example.edu
# The name Caddy obtains a certificate for. Usually the same host as APP_ORIGIN.
SITE_ADDRESS=portal.example.edu
ACME_EMAIL=it-operations@example.edu

# Ports Caddy publishes. 80 must stay open for the ACME HTTP challenge.
HTTP_PORT=80
HTTPS_PORT=443

# --- Database --------------------------------------------------------------
POSTGRES_DB=school_portal_v3
POSTGRES_USER=portal_app
POSTGRES_PASSWORD=REPLACE_ME_strong_database_password

# --- Application secrets ---------------------------------------------------
# At least 32 characters, unique to this deployment, never reused.
SECRET_KEY=REPLACE_ME_openssl_rand_hex_32

# --- Document storage ------------------------------------------------------
# "local" keeps documents on the `documents` named volume. "s3" requires the
# bucket settings below. Uploads are refused while MALWARE_SCANNER is
# "disabled" (fail-closed); set it to "clamav" and run a ClamAV instance to
# enable student uploads.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/var/storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# The production compose file runs a ClamAV service, so scanning is on by
# default. `disabled` still fails closed (uploads are refused with 503); it
# only means no document can ever be uploaded. `dev-clean` and `eicar-test`
# are refused by the application's production validator.
MALWARE_SCANNER=clamav
# Address of the ClamAV daemon. It runs outside this composition, so point the
# API at it instead of assuming it shares the compose network. Uploads fail
# closed (503 SCANNER_UNAVAILABLE) rather than storing an unscanned file.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=10

# --- Password recovery -----------------------------------------------------
# "disabled" hides the reset flow because no delivery channel is configured.
# There is no bundled email provider yet (see docs/deployment-v3.md).
PASSWORD_RESET_DELIVERY=disabled

# --- Session and limits ----------------------------------------------------
SESSION_EXPIRE_MINUTES=10080
MAX_UPLOAD_SIZE_MB=10
MAX_IMPORT_ROWS=500
MAX_IMPORT_SIZE_MB=5
MAX_EXPORT_ROWS=10000
LOG_LEVEL=INFO
SLOW_REQUEST_MS=1500

# --- First administrator ---------------------------------------------------
# Used once by `python -m app.cli bootstrap-admin` to create the first admin.
BOOTSTRAP_ADMIN_EMAIL=registrar@example.edu

# --- Internal network ------------------------------------------------------
# Must match the compose network subnet; the API trusts forwarded headers from
# exactly this range.
PROD_NETWORK_SUBNET=172.31.240.0/24

# --- Database roles --------------------------------------------------------
# The API must NOT connect as POSTGRES_USER: that account is a superuser
# and owns every table, so it could rewrite audit history and drop the
# triggers that protect it. `provision-roles` creates this ordinary
# application role and grants it SELECT/INSERT only on `audit_logs`.
#
# Deployment order: migrate -> provision-roles -> up.
POSTGRES_APP_USER=sycumain_app
POSTGRES_APP_PASSWORD=REPLACE_ME

# --- ClamAV ----------------------------------------------------------------
# The published ClamAV images are amd64-only; on an arm64 host they run
# under emulation, which is slower but functional.
CLAMAV_PLATFORM=linux/amd64

