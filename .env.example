# Database
DATABASE_URL=postgresql://portal:portal@localhost:5433/school_portal

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production

# CORS
CORS_ORIGINS=["http://localhost:3100"]

# Logging
# LOG_FORMAT: auto (text in development, JSON elsewhere), json, or text.
# JSON lines are what a log collector expects; text is what a human reads.
LOG_LEVEL=info
LOG_FORMAT=auto
# Requests slower than this are logged at WARNING for later investigation.
SLOW_REQUEST_MS=1000
# Echo SQL (with bound parameters) to the log. Off by default: parameters are
# personal data. Never enable this in production.
SQL_ECHO=false

# Demo data
# Seeding always reconciles roles and permissions; the demo students, rooms,
# applications and the password123 accounts are only created when this is on.
# Unset means "on unless ENVIRONMENT=production".
SEED_DEMO_DATA=true
# Password for the demonstration accounts the seed creates (admin@, management@,
# teacher@ and student@school.portal). Used only when demo seeding is on, which
# production forbids. The login page's development-only account chips receive
# the same value as NEXT_PUBLIC_DEMO_PASSWORD, and scripts/demo_accounts.py
# rotates the accounts away from it and records the results in
# .demo-credentials.json (mode 0600, git-ignored). Never reuse it institutionally.
DEMO_PASSWORD=Sycumain2026!
# Phase 1 admission episode writes. Off preserves the legacy onboarding path;
# enable deliberately and redeploy. Episodes already written are retained.
ADMISSIONS_WRITE_ENABLED=false
# Phase 2 migration verification console. Off leaves all existing trust data intact.
ADMISSION_MIGRATION_CONSOLE_ENABLED=false
# Phase 4 controlled programme/placement change requests. Off leaves existing
# approved changes and pending requests readable; creation/review becomes unavailable.
ADMISSION_CHANGE_REQUESTS_ENABLED=false
ADMISSION_DATE_CORRECTION_ENABLED=false
ADMISSION_CORRECTIONS_ENABLED=false
# Phase 6 immigration cohort source: POINTER uses
# students.original_admission_id + verification trust. Set LEGACY to roll back
# to the pre-Phase-6 overview; the switch is read-only either way.
ADMISSION_COHORT_SOURCE=POINTER

# Malware scanning
# Uploads are refused when no scanner is reachable; this is deliberate.
# Start a local ClamAV daemon on TCP 3310, or point these at a private
# production ClamAV service. Never use eicar-test outside the test stack.
MALWARE_SCANNER=clamav
CLAMAV_HOST=host.docker.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# Data intake limits
# A file larger than either limit is rejected before it is parsed.
MAX_IMPORT_ROWS=1000
MAX_IMPORT_SIZE_MB=10
# Directory export is capped so one request cannot exhaust memory or the DB.
MAX_EXPORT_ROWS=5000

# API
API_V1_PREFIX=/api/v1

# Session
SESSION_EXPIRE_MINUTES=10080

# Password recovery
# disabled = no self-service reset; the login screen offers no recovery link
# dev      = the reset token is returned to the client for local testing.
#            NEVER enable this in production.
# Any other value enables self-service recovery but assumes an out-of-band
# delivery channel; wiring a real mail provider is a Stage 8 hardening item.
PASSWORD_RESET_DELIVERY=disabled
PASSWORD_RESET_EXPIRE_MINUTES=30

# Frontend (for docker)
NEXT_PUBLIC_API_URL=http://localhost:8000
